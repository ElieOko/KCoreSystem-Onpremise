CREATE TABLE sync_outbox (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    entity_type TEXT NOT NULL,
    entity_id TEXT NOT NULL,
    operation TEXT NOT NULL,
    payload TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    retry_count INTEGER NOT NULL DEFAULT 0,
    last_error TEXT,
    priority INTEGER NOT NULL DEFAULT 0
);

insertOutboxItem:
INSERT INTO sync_outbox(entity_type, entity_id, operation, payload, created_at, priority)
VALUES (?, ?, ?, ?, ?, ?);

selectPendingOutbox:
SELECT * FROM sync_outbox ORDER BY priority DESC, created_at ASC LIMIT :limit;

deleteOutboxItem:
DELETE FROM sync_outbox WHERE id = :id;

incrementOutboxRetry:
UPDATE sync_outbox SET retry_count = retry_count + 1, last_error = :last_error WHERE id = :id;

countPendingOutbox:
SELECT COUNT(*) FROM sync_outbox;

CREATE TABLE local_primary_stat (
    id TEXT NOT NULL PRIMARY KEY,
    submission_id TEXT NOT NULL,
    school_id TEXT NOT NULL,
    class_name TEXT NOT NULL,
    class_order INTEGER NOT NULL,
    boys_count INTEGER NOT NULL DEFAULT 0,
    girls_count INTEGER NOT NULL DEFAULT 0,
    sync_status TEXT NOT NULL DEFAULT 'PENDING_SYNC',
    updated_at INTEGER NOT NULL
);

selectPrimaryStatsBySubmission:
SELECT * FROM local_primary_stat WHERE submission_id = :submission_id ORDER BY class_order ASC;

upsertPrimaryStat:
INSERT OR REPLACE INTO local_primary_stat(
    id, submission_id, school_id, class_name, class_order, boys_count, girls_count, sync_status, updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

deletePrimaryStatsForSubmission:
DELETE FROM local_primary_stat WHERE submission_id = :submission_id;
