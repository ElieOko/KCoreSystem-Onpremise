{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "KCoreSystem: Run Desktop",
      "type": "shell",
      "command": "./gradlew",
      "args": [":desktopApp:run"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "KCoreSystem: Build Desktop",
      "type": "shell",
      "command": "./gradlew",
      "args": [":desktopApp:compileKotlin"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "KCoreSystem: Tests",
      "type": "shell",
      "command": "./gradlew",
      "args": [":shared:jvmTest"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "KCoreSystem: Package MSI (Windows)",
      "type": "shell",
      "command": "./gradlew",
      "args": [":desktopApp:packageMsi"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    }
  ]
}
